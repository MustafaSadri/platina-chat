# ---------------------------------------------------------------------------
# TeamChat configuration. Copy to .env for local development.
# On Render, set these in the dashboard (Environment tab) — never commit real values.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
# Public URL of the app (your custom domain in production), no trailing slash.
APP_URL=http://localhost:3000

# --- Database: Neon PostgreSQL --------------------------------------------
# Pooled connection string (host contains "-pooler") for the app:
DATABASE_URL=postgres://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/teamchat?sslmode=require
# Direct (non-pooled) connection string, used for migrations:
DATABASE_URL_UNPOOLED=postgres://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/teamchat?sslmode=require
# TLS to the database (defaults to on in production). Set false for a local database.
DATABASE_SSL=false
DATABASE_POOL_MAX=10
# Run migrations automatically at startup (default true).
MIGRATE_ON_START=true

# --- File storage: Cloudflare R2 (S3-compatible, private bucket) ------------
# STORAGE_DRIVER=s3 is selected automatically when S3_BUCKET is set; "local" is for development only.
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./data/uploads
S3_BUCKET=
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MAX_UPLOAD_MB=100

# --- Calls (WebRTC) --------------------------------------------------------
# STUN works for most networks; TURN is needed for calls behind strict NATs/firewalls.
# Option A: Cloudflare Realtime TURN (short-lived credentials are generated per call)
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
# Option B: any TURN server with static credentials (e.g. coturn, Metered, Twilio)
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
# STUN_URLS=stun:stun.cloudflare.com:3478,stun:stun.l.google.com:19302

# --- Message translation (English <-> Russian) -------------------------------
# Disabled when empty. Options: deepl | google | libretranslate
# NOTE: translated message text is sent to the chosen provider.
TRANSLATE_PROVIDER=
DEEPL_API_KEY=
GOOGLE_TRANSLATE_API_KEY=
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=

# --- Web Push notifications (optional) --------------------------------------
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# --- Optional ---------------------------------------------------------------
# Redis enables multiple app instances (Socket.IO adapter). Leave empty for a single instance.
REDIS_URL=
SESSION_DAYS=30
LOGIN_RATE_LIMIT=10
API_RATE_LIMIT=600
# Number of proxies in front of the app (Render = 1).
TRUST_PROXY=1
# Extra origins allowed to call the API (e.g. Vite dev server http://localhost:5173)
ALLOWED_ORIGINS=
