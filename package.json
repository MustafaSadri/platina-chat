{
  "name": "teamchat",
  "version": "1.0.0",
  "private": true,
  "description": "Private business messenger: real-time chat, files, voice messages and WebRTC calls.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch server/src/index.js",
    "dev:client": "vite --config client/vite.config.js",
    "build": "vite build --config client/vite.config.js",
    "start": "node server/src/index.js",
    "migrate": "node server/src/migrate.js",
    "create-admin": "node server/src/scripts/create-admin.js",
    "test": "node --test --test-concurrency=1 server/test/",
    "db:local": "node server/src/scripts/local-db.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/lib-storage": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "bcryptjs": "^3.0.3",
    "busboy": "^1.6.0",
    "compression": "^1.8.2",
    "cookie": "^1.1.1",
    "dotenv": "^18.0.9",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "redis": "^6.3.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "vite": "^5.4.21",
    "web-push": "^3.6.7",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "embedded-postgres": "^18.6.0-beta.19",
    "puppeteer-core": "^24.43.1"
  }
}
